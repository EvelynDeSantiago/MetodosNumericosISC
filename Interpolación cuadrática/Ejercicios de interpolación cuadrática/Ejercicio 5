using System;

class InterpolacionCuadratica
{
    static double Interpolar(double x0, double y0,
                             double x1, double y1,
                             double x2, double y2,
                             double x)
    {
        double L0 = ((x - x1) * (x - x2)) / ((x0 - x1) * (x0 - x2));
        double L1 = ((x - x0) * (x - x2)) / ((x1 - x0) * (x1 - x2));
        double L2 = ((x - x0) * (x - x1)) / ((x2 - x0) * (x2 - x1));

        return y0 * L0 + y1 * L1 + y2 * L2;
    }

    static void Main()
    {
        double resultado = Interpolar(1, 3, 2, 12, 3, 27, 2.5);

        Console.WriteLine("Valor interpolado: " + resultado);
    }
}

