using System;

class Program
{
    static void Main()
    {
        double valorReal = 15.5;
        double valorAproximado = 14.9;

        double errorRelativo = Math.Abs((valorReal - valorAproximado) / valorReal);

        Console.WriteLine("Valor real: " + valorReal);
        Console.WriteLine("Valor aproximado: " + valorAproximado);
        Console.WriteLine("Error relativo: " + errorRelativo);
    }
}

