using System;

class Lagrange
{
    static double Interpolar(double[] x, double[] y, double valor)
    {
        double resultado = 0;
        int n = x.Length;

        for (int i = 0; i < n; i++)
        {
            double termino = y[i];

            for (int j = 0; j < n; j++)
            {
                if (j != i)
                {
                    termino *= (valor - x[j]) / (x[i] - x[j]);
                }
            }

            resultado += termino;
        }

        return resultado;
    }

    static void Main()
    {
        double[] x = { 2, 4, 6 };
        double[] y = { 4, 16, 36 };

        double resultado = Interpolar(x, y, 5);

        Console.WriteLine("Valor interpolado: " + resultado);
    }
}

