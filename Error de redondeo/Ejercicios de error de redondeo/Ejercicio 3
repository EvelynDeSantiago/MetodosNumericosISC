using System;

class Program
{
    static void Main()
    {
        double numero = 98.7654;
        double redondeado = Math.Round(numero, 0);

        double errorRedondeo = Math.Abs(numero - redondeado);

        Console.WriteLine("Número original: " + numero);
        Console.WriteLine("Número redondeado: " + redondeado);
        Console.WriteLine("Error de redondeo: " + errorRedondeo);
    }
}


