using System;

class InterpolacionLineal
{
    static double Interpolar(double x0, double y0,
                              double x1, double y1,
                              double x)
    {
        return y0 + ((y1 - y0) / (x1 - x0)) * (x - x0);
    }

    static void Main()
    {
        double resultado = Interpolar(1, 2, 5, 10, 3);

        Console.WriteLine("Valor interpolado: " + resultado);
    }
}

