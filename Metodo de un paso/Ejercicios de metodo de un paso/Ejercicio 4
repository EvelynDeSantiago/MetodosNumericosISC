using System;

class MetodoUnPaso
{
    static double Funcion(double x, double y)
    {
        return Math.Sin(x) + y;
    }

    static void Main()
    {
        double x = 0;
        double y = 1;
        double h = 0.1;

        for (int i = 0; i < 5; i++)
        {
            y = y + h * Funcion(x, y);
            x = x + h;

            Console.WriteLine("x = " + x + " y = " + y);
        }
    }
}

