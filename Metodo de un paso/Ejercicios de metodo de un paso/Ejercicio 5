using System;

class MetodoUnPaso
{
    static double Funcion(double x, double y)
    {
        return Math.Cos(x) - y;
    }

    static void Main()
    {
        double x = 0;
        double y = 0;
        double h = 0.2;

        for (int i = 0; i < 5; i++)
        {
            y = y + h * Funcion(x, y);
            x = x + h;

            Console.WriteLine("x = " + x + " y = " + y);
        }
    }
}

