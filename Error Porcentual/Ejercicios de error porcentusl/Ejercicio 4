using System;

class Program
{
    static void Main()
    {
        double valorReal = 300;
        double valorAproximado = 285;

        double errorPorcentual = (Math.Abs(valorReal - valorAproximado) / valorReal) * 100;

        Console.WriteLine("Valor real: " + valorReal);
        Console.WriteLine("Valor aproximado: " + valorAproximado);
        Console.WriteLine("Error porcentual: " + errorPorcentual + "%");
    }
}

---------------------------Salida en pantalla------------------------------------------

Valor real: 300
Valor aproximado: 285
Error porcentual: 5%