Implementación en Java
import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        // Tamaño de la matriz
        System.out.print("Ingrese el tamaño de la matriz: ");
        int n = scanner.nextInt();

        // Declaración de matriz y vector
        double[][] A = new double[n][n];
        double[] b = new double[n];

        // Lectura de la matriz
        System.out.println("Ingrese los valores de la matriz A:");

        for (int i = 0; i < n; i++) {

            for (int j = 0; j < n; j++) {

                A[i][j] = scanner.nextDouble();
            }
        }

        // Lectura del vector independiente
        System.out.println("Ingrese los valores del vector b:");

        for (int i = 0; i < n; i++) {

            b[i] = scanner.nextDouble();
        }

        // Resolver sistema
        double[] solucion = jacobi(A, b);

        // Mostrar resultados
        System.out.println("Solución aproximada:");

        for (int i = 0; i < solucion.length; i++) {

            System.out.println("x[" + i + "] = " + solucion[i]);
        }

        scanner.close();
    }

    public static double[] jacobi(double[][] A, double[] b) {

        int n = A.length;

        double[] xAnterior = new double[n];
        double[] xNuevo = new double[n];

        // Inicializar vector en cero
        for (int i = 0; i < n; i++) {

            xAnterior[i] = 0;
        }

        // Número de iteraciones
        for (int iteracion = 0; iteracion < 50; iteracion++) {

            for (int i = 0; i < n; i++) {

                double suma = 0;

                for (int j = 0; j < n; j++) {

                    if (j != i) {

                        suma += A[i][j] * xAnterior[j];
                    }
                }

                xNuevo[i] = (b[i] - suma) / A[i][i];
            }

            // Actualizar valores
            for (int i = 0; i < n; i++) {

                xAnterior[i] = xNuevo[i];
            }
        }

        return xNuevo;
    }
}