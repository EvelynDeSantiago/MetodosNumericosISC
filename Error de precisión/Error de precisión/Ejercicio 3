using System;

class Program
{
    static void Main()
    {
        double numeroExacto = 99.999999;
        float numeroPrecision = (float)numeroExacto;

        double errorPrecision = Math.Abs(numeroExacto - numeroPrecision);

        Console.WriteLine("Número exacto: " + numeroExacto);
        Console.WriteLine("Número con menor precisión: " + numeroPrecision);
        Console.WriteLine("Error de precisión: " + errorPrecision);
    }
}

