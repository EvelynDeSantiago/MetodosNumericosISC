Implementación en Java

import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        // Tamaño del sistema
        System.out.print("Ingrese el tamaño de la matriz: ");
        int n = scanner.nextInt();

        // Declaración de matriz y vector
        double[][] A = new double[n][n];
        double[] b = new double[n];

        // Lectura de la matriz
        System.out.println("Ingrese los valores de la matriz A:");

        for (int i = 0; i < n; i++) {

            for (int j = 0; j < n; j++) {

                System.out.print("A[" + i + "][" + j + "] = ");
                A[i][j] = scanner.nextDouble();
            }
        }

        // Lectura del vector independiente
        System.out.println("Ingrese los valores del vector b:");

        for (int i = 0; i < n; i++) {

            System.out.print("b[" + i + "] = ");
            b[i] = scanner.nextDouble();
        }

        // Resolver sistema
        double[] resultado = gaussSeidel(A, b);

        // Mostrar resultados
        System.out.println("Resultado aproximado:");

        for (int i = 0; i < resultado.length; i++) {

            System.out.printf("x[%d] = %.4f\n", i, resultado[i]);
        }

        scanner.close();
    }

    public static double[] gaussSeidel(double[][] A, double[] b) {

        int n = b.length;

        double[] x = new double[n];
        double[] anterior = new double[n];

        // Inicialización
        for (int i = 0; i < n; i++) {

            x[i] = 0;
        }

        while (true) {

            // Guardar valores anteriores
            System.arraycopy(x, 0, anterior, 0, n);

            // Nueva aproximación
            for (int i = 0; i < n; i++) {

                double suma = 0;

                for (int j = 0; j < n; j++) {

                    if (j != i) {

                        suma += A[i][j] * x[j];
                    }
                }

                x[i] = (b[i] - suma) / A[i][i];
            }

            // Cálculo del error
            double errorMaximo = 0;

            for (int i = 0; i < n; i++) {

                double diferencia = Math.abs(x[i] - anterior[i]);

                if (diferencia > errorMaximo) {

                    errorMaximo = diferencia;
                }
            }

            // Verificar convergencia
            if (errorMaximo < 0.0001) {

                break;
            }
        }

        return x;
    }
}